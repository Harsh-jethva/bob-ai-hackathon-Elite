# PortPilot AI — Environment Configuration

# Ingestion Stream Mode: synthetic | historical | live
DATA_MODE=live

# AIS Ingestion Provider: auto | spire | marinetraffic | aishub | simulated_live
AIS_PROVIDER=auto
AIS_API_KEY=

# Terminal Operating System (TOS) Integration
TOS_ENDPOINT=
TOS_API_KEY=

# Marine Weather Provider: open-meteo | noaa | mock
WEATHER_PROVIDER=open-meteo

# Optimization & Solver Settings
SOLVER_TIME_LIMIT_SECONDS=5
SOLVER_WORKERS=8
