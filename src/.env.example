# =============================================================================
# PortPilot AI — Environment Configuration Template
# Copy this file to .env and fill in your values (NEVER commit .env)
# =============================================================================

# Ingestion Stream Mode: synthetic | historical | live
DATA_MODE=synthetic

# AIS Live Ingestion Provider: auto | spire | marinetraffic | aishub | simulated_live
AIS_PROVIDER=auto
AIS_API_KEY=

# Terminal Operating System (TOS) Integration
TOS_ENDPOINT=
TOS_API_KEY=

# Marine Weather Provider: open-meteo | noaa | mock
WEATHER_PROVIDER=open-meteo

# Optimization & Solver Settings
SOLVER_TIME_LIMIT_SECONDS=5
SOLVER_WORKERS=8
